{
  "name": "heraldry-crawler",
  "version": "1.0.0",
  "description": "Index heraldry data from Wikipedia",
  "main": "dist/index.js",
  "scripts": {
    "typeorm": "ts-node ./node_modules/.bin/typeorm",
    "init-dbs": "rm -f data/dev/db.sqlite && yarn init-indices",
    "init-indices": "ts-node scripts/initIndices.ts",
    "crawl": "ts-node scripts/crawl.ts",
    "crawl-credits": "ts-node scripts/crawlCredits.ts",
    "crawl-geoloc": "ts-node scripts/crawlLocations.ts",
    "generate-sitemap": "ts-node scripts/generateSitemap.ts",
    "push-db": "ts-node scripts/pushFullDB.ts",
    "start": "nodemon src/server.ts",
    "lint": "eslint ./scripts ./src",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Bertrand d'Aure",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@elastic/elasticsearch": "^7.13.0",
    "algoliasearch": "^4.19.1",
    "axios": "^1.12.1",
    "bluebird": "^3.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cli-progress": "^3.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lodash.chunk": "^4.2.0",
    "ngeohash": "^0.6.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/algoliasearch": "^4.0.4",
    "@types/bluebird": "^3.5.42",
    "@types/cheerio": "^0.22.31",
    "@types/cli-progress": "^3.11.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.17",
    "@types/lodash.chunk": "^4.2.9",
    "@types/ngeohash": "^0.6.8",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6"
  }
}
